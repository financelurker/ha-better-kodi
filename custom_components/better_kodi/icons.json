{
  "services": {
    "call_method": {
      "service": "mdi:console"
    },
    "get_queue": {
      "service": "mdi:playlist-play"
    },
    "remove_from_queue": {
      "service": "mdi:playlist-remove"
    },
    "move_queue_item": {
      "service": "mdi:swap-vertical"
    },
    "handover": {
      "service": "mdi:transfer"
    }
  },
  "entity": {
    "text": {
      "link": {
        "default": "mdi:link-variant"
      }
    },
    "button": {
      "play_now": {
        "default": "mdi:play"
      },
      "play_next": {
        "default": "mdi:skip-next"
      },
      "add_to_queue": {
        "default": "mdi:playlist-plus"
      },
      "replace_queue": {
        "default": "mdi:playlist-music"
      },
      "library_scan": {
        "default": "mdi:folder-refresh"
      },
      "library_clean": {
        "default": "mdi:broom"
      }
    }
  }
}
